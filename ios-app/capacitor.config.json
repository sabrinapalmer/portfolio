{
  "appId": "com.sabrinapalmer.map",
  "appName": "BrinaMaps",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f7f4ff"
  },
  "plugins": {
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": false
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#f7f4ff",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    }
  }
}
