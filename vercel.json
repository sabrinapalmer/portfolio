{
  "rewrites": [
    {
      "source": "/networth",
      "destination": "/networth/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://brinamaps.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/map",
      "destination": "https://brinamaps.com/map",
      "permanent": false
    },
    {
      "source": "/map/:path*",
      "destination": "https://brinamaps.com/map/:path*",
      "permanent": false
    }
  ]
}
