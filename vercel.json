{
  "rewrites": [
    {
      "source": "/networth",
      "destination": "/networth/index.html"
    },
    {
      "source": "/map",
      "destination": "/map/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/map/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/map"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/map/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
